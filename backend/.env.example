# =============================================
#   BLAZE KITCHEN — Environment Variables
#   Copy this file to .env and fill in values
# =============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blaze-kitchen?retryWrites=true&w=majority

# JWT Secret (use a long random string — minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS — no trailing slash)
CLIENT_URL=http://127.0.0.1:5500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_api_token
PHONE_NUMBER_ID=9108699368
