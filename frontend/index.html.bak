<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blaze Kitchen — Fire-Crafted Excellence | Cloud Kitchen Bangalore</title>
  <meta name="description" content="Premium cloud kitchen delivering 120+ signature dishes in 30 minutes. Gourmet burgers, artisan coffee, desserts & more. Order now with BLAZE50 for ₹50 off.">
  <meta name="keywords" content="cloud kitchen bangalore, gourmet burgers, food delivery, blaze kitchen">
  <meta name="theme-color" content="#FF5E00">

  <!-- Open Graph -->
  <meta property="og:title" content="Blaze Kitchen — Fire-Crafted Excellence">
  <meta property="og:description" content="120+ signature dishes. Zero compromises. Delivered in 30 minutes.">
  <meta property="og:image" content="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=1200">
  <meta property="og:type" content="website">

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icon-192.png">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,600;0,9..40,700;1,9..40,300&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="css/main.css">
</head>
<body>

<!-- ── CURSOR ── -->
<div class="cursor" id="cursor"></div>
<div class="cursor-dot" id="cursorDot"></div>

<!-- ── PWA INSTALL BANNER ── -->
<div class="pwa-banner" id="pwaBanner">
  <div class="pwa-banner-text">🔥 Install Blaze Kitchen App for a better experience!</div>
  <div class="pwa-banner-actions">
    <button class="btn-pwa-install" id="pwaInstall">Install</button>
    <button class="btn-pwa-dismiss" id="pwaDismiss">Not now</button>
  </div>
</div>

<!-- ── NAVBAR ── -->
<nav class="navbar" id="navbar">
  <div class="navbar-container">
    <a href="#" class="logo">
      <span class="logo-fire">🔥</span>
      <span class="logo-text">BLAZE</span>
      <span class="logo-sub">KITCHEN</span>
    </a>
    <ul class="nav-links">
      <li><a href="#menu" class="nav-link">Menu</a></li>
      <li><a href="#specials" class="nav-link">Specials</a></li>
      <li><a href="#about" class="nav-link">About</a></li>
      <li><a href="#contact" class="nav-link">Contact</a></li>
    </ul>
    <div class="nav-actions">
      <button class="nav-btn wishlist-btn" id="wishlistBtn" aria-label="Wishlist">
        <i class="fas fa-heart"></i>
        <span class="wishlist-count" id="wishlistCount">0</span>
      </button>
      <button class="nav-btn cart-btn" id="cartBtn">
        <i class="fas fa-bag-shopping"></i>
        <span>Cart</span>
        <span class="cart-badge" id="cartCount">0</span>
      </button>
      <button class="nav-btn login-btn" id="loginBtn">
        <i class="fas fa-user-circle"></i>
        <span id="loginBtnText">Login</span>
      </button>
      <button class="menu-toggle" id="menuToggle" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- ── MOBILE MENU ── -->
<div class="mobile-nav" id="mobileNav">
  <a href="#menu" class="mobile-nav-link" onclick="closeMobileMenu()">Menu</a>
  <a href="#specials" class="mobile-nav-link" onclick="closeMobileMenu()">Specials</a>
  <a href="#about" class="mobile-nav-link" onclick="closeMobileMenu()">About</a>
  <a href="#contact" class="mobile-nav-link" onclick="closeMobileMenu()">Contact</a>
</div>

<!-- ── HERO ── -->
<section class="hero" id="hero">
  <div class="hero-bg-grid"></div>
  <div class="hero-slides" id="heroSlides">
    <div class="hero-slide active" style="--slide-img:url('https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=1600&q=90&fit=crop')"></div>
    <div class="hero-slide" style="--slide-img:url('https://images.unsplash.com/photo-1571091718767-18b5b1457add?w=1600&q=90&fit=crop')"></div>
    <div class="hero-slide" style="--slide-img:url('https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=1600&q=90&fit=crop')"></div>
    <div class="hero-slide" style="--slide-img:url('https://images.unsplash.com/photo-1461023058943-07fcbe16d735?w=1600&q=90&fit=crop')"></div>
    <div class="hero-slide" style="--slide-img:url('https://images.unsplash.com/photo-1573080496219-bb080dd4f877?w=1600&q=90&fit=crop')"></div>
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-eyebrow">
      <span class="hero-dot"></span><span>Cloud Kitchen · Bangalore</span><span class="hero-dot"></span>
    </div>
    <h1 class="hero-title">
      <span class="hero-title-line" data-text="FIRE-CRAFTED">FIRE-CRAFTED</span>
      <span class="hero-title-line accent" data-text="EXCELLENCE">EXCELLENCE</span>
    </h1>
    <p class="hero-desc">Over 120 signature dishes. Zero compromises. Delivered to your door in 30 minutes.</p>
    <div class="hero-actions">
      <button class="btn-hero-primary" id="scrollToMenu">
        <span>Explore Menu</span><i class="fas fa-arrow-right"></i>
      </button>
      <button class="btn-hero-secondary" id="heroOrderBtn">
        <i class="fas fa-bolt"></i><span>Order Now</span>
      </button>
    </div>
    <div class="hero-stats">
      <div class="hero-stat"><span class="stat-num">120+</span><span class="stat-label">Menu Items</span></div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat"><span class="stat-num">30 min</span><span class="stat-label">Delivery</span></div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat"><span class="stat-num">4.9★</span><span class="stat-label">Rating</span></div>
    </div>
  </div>
  <div class="hero-slider-nav">
    <button class="slider-dot active" data-index="0"></button>
    <button class="slider-dot" data-index="1"></button>
    <button class="slider-dot" data-index="2"></button>
    <button class="slider-dot" data-index="3"></button>
    <button class="slider-dot" data-index="4"></button>
  </div>
  <div class="hero-scroll-hint">
    <span>Scroll</span><div class="scroll-line"></div>
  </div>
</section>

<!-- ── TICKER ── -->
<div class="ticker-bar">
  <div class="ticker-track">
    <span>🔥 Free delivery on orders above ₹499</span>
    <span>⚡ Use code BLAZE50 for ₹50 off</span>
    <span>🍔 New Korean BBQ Burger is here!</span>
    <span>🎉 Use FIRST100 for ₹100 off your first order</span>
    <span>🍕 Family Feast Box — serves 4 for just ₹999</span>
    <span>🔥 Free delivery on orders above ₹499</span>
    <span>⚡ Use code BLAZE50 for ₹50 off</span>
    <span>🍔 New Korean BBQ Burger is here!</span>
    <span>🎉 Use FIRST100 for ₹100 off your first order</span>
    <span>🍕 Family Feast Box — serves 4 for just ₹999</span>
  </div>
</div>

<!-- ── MENU ── -->
<section class="category-strip" id="menu">
  <div class="container">
    <div class="section-header reveal" id="menuHeader">
      <div class="section-label">EXPLORE</div>
      <h2 class="section-title">Order our best <span class="accent-text">food options</span></h2>
    </div>

    <!-- Search -->
    <div class="search-wrapper">
      <div class="search-box">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="searchInput" placeholder="Search burgers, shakes, desserts…" class="search-input" autocomplete="off">
        <button class="search-clear" id="searchClear" style="display:none"><i class="fas fa-times"></i></button>
      </div>
    </div>

    <!-- Category Carousel (Horizontal Tabs) -->
    <div class="category-carousel-wrapper">
      <button class="carousel-arrow carousel-arrow-left" id="categoryScrollLeft">
        <i class="fas fa-chevron-left"></i>
      </button>
      <div class="category-carousel" id="categoryCarousel">
        <!-- Categories will be populated from API -->
      </div>
      <button class="carousel-arrow carousel-arrow-right" id="categoryScrollRight">
        <i class="fas fa-chevron-right"></i>
      </button>
    </div>

    <!-- Advanced Filters (hidden by default, can still be used with search) -->
    <div class="advanced-filter-row" style="display:none">
      <button class="adv-filter-chip" id="advVeg"><i class="fas fa-leaf"></i> Veg Only</button>
      <button class="adv-filter-chip" id="advAvailable"><i class="fas fa-circle-check"></i> Available Now</button>
      <div class="calorie-range">
        <span>Max Calories:</span>
        <input type="range" id="calFilter" min="100" max="1500" value="1500" step="50">
        <span id="calVal">1500 kcal</span>
      </div>
    </div>
  </div>
</section>

<!-- ── MENU SECTION ── -->
<section class="menu-section">
  <div class="container">
    <!-- Menu Toolbar -->
    <div class="menu-toolbar">
      <div class="menu-result-count" id="resultCount"></div>
      <select class="sort-select" id="sortSelect">
        <option value="default">Featured</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
        <option value="name">A–Z</option>
        <option value="rating">Top Rated</option>
      </select>
    </div>

    <div class="menu-grid" id="menuGrid">
      <div class="menu-card skeleton"></div>
      <div class="menu-card skeleton"></div>
      <div class="menu-card skeleton"></div>
      <div class="menu-card skeleton"></div>
      <div class="menu-card skeleton"></div>
      <div class="menu-card skeleton"></div>
    </div>
    <div class="load-more-wrapper">
      <button class="btn-load-more" id="loadMoreBtn" style="display:none">
        <span>Load More</span><i class="fas fa-chevron-down"></i>
      </button>
    </div>
  </div>
</section>

<!-- ── SPECIALS ── -->
<section class="specials" id="specials">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">CHEF'S PICKS</div>
      <h2 class="section-title">Today's <span class="accent-text">Specials</span></h2>
    </div>
    <div class="specials-grid">
      <div class="special-card special-card--fire">
        <div class="special-card-bg" style="background-image:url('https://images.unsplash.com/photo-1594212699903-ec8a3eca50f5?w=800&q=80')"></div>
        <div class="special-card-content">
          <span class="special-tag">🔥 HOT</span>
          <h3>Spicy Ghost Burger</h3>
          <p>Ghost pepper sauce, fiery jalapeños, pepper jack cheese</p>
          <div class="special-price">₹279</div>
          <button class="btn-special" onclick="quickAdd('Spicy Ghost Burger',279,'burgers','https://images.unsplash.com/photo-1594212699903-ec8a3eca50f5?w=500&q=80')">Add to Cart</button>
        </div>
      </div>
      <div class="special-card special-card--sweet">
        <div class="special-card-bg" style="background-image:url('https://images.unsplash.com/photo-1606313564200-e75d5e30476c?w=800&q=80')"></div>
        <div class="special-card-content">
          <span class="special-tag">⭐ BESTSELLER</span>
          <h3>Molten Lava Cake</h3>
          <p>Warm chocolate cake, flowing molten center, vanilla ice cream</p>
          <div class="special-price">₹199</div>
          <button class="btn-special" onclick="quickAdd('Molten Lava Cake',199,'desserts','https://images.unsplash.com/photo-1606313564200-e75d5e30476c?w=500&q=80')">Add to Cart</button>
        </div>
      </div>
      <div class="special-card special-card--brew">
        <div class="special-card-bg" style="background-image:url('https://images.unsplash.com/photo-1461023058943-07fcbe16d735?w=800&q=80')"></div>
        <div class="special-card-content">
          <span class="special-tag">☕ NEW</span>
          <h3>Signature Cold Brew</h3>
          <p>Single origin beans, cold brewed 24 hours. Black or oat milk.</p>
          <div class="special-price">₹149</div>
          <button class="btn-special" onclick="quickAdd('Signature Cold Brew',149,'coffee','https://images.unsplash.com/photo-1461023058943-07fcbe16d735?w=500&q=80')">Add to Cart</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── COUNTERS ── -->
<section class="counters-section">
  <div class="container">
    <div class="counters-grid">
      <div class="reveal">
        <div class="counter-num" data-target="50000" data-suffix="+">0+</div>
        <div class="counter-label">Orders Delivered</div>
      </div>
      <div class="reveal">
        <div class="counter-num" data-target="120" data-suffix="+">0+</div>
        <div class="counter-label">Menu Items</div>
      </div>
      <div class="reveal">
        <div class="counter-num" data-target="98" data-suffix="%">0%</div>
        <div class="counter-label">Satisfaction Rate</div>
      </div>
      <div class="reveal">
        <div class="counter-num" data-target="5" data-suffix=" Yrs">0 Yrs</div>
        <div class="counter-label">Years of Excellence</div>
      </div>
    </div>
  </div>
</section>

<!-- ── ABOUT ── -->
<section class="about" id="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-visual reveal">
        <div class="about-img-main">
          <img src="https://images.unsplash.com/photo-1555939594-58d7cb561231?w=600&q=80" alt="Blaze Kitchen" loading="lazy">
        </div>
        <div class="about-img-secondary">
          <img src="https://images.unsplash.com/photo-1600891964092-4316c288032e?w=300&q=80" alt="Fresh Ingredients" loading="lazy">
        </div>
        <div class="about-badge">
          <span class="about-badge-num">5+</span>
          <span class="about-badge-text">Years of<br>Fire</span>
        </div>
      </div>
      <div class="about-content reveal">
        <div class="section-label">OUR STORY</div>
        <h2 class="section-title">Born in <span class="accent-text">Fire</span>,<br>Served with Love</h2>
        <p class="about-desc">Blaze Kitchen started as a single kitchen with one obsession — making food that makes people close their eyes and pause. From our signature gourmet burgers to artisan cold brews, every dish is crafted fresh to order with premium ingredients.</p>

        <!-- Timeline -->
        <div class="timeline">
          <div class="timeline-item">
            <div class="timeline-year">2019</div>
            <div class="timeline-title">The Spark 🔥</div>
            <div class="timeline-text">Started in a 200 sqft kitchen with 5 burger recipes and a dream.</div>
          </div>
          <div class="timeline-item">
            <div class="timeline-year">2021</div>
            <div class="timeline-title">Going Digital</div>
            <div class="timeline-text">Launched our own ordering platform, hit 10,000 orders in year one.</div>
          </div>
          <div class="timeline-item">
            <div class="timeline-year">2023</div>
            <div class="timeline-title">120+ Items Strong</div>
            <div class="timeline-text">Expanded to full menu with coffee, desserts, combos & beverages.</div>
          </div>
          <div class="timeline-item">
            <div class="timeline-year">2025</div>
            <div class="timeline-title">Startup Grade 🚀</div>
            <div class="timeline-text">AI recommendations, real-time tracking, and 50K+ happy customers.</div>
          </div>
        </div>

        <div class="about-pillars">
          <div class="pillar"><div class="pillar-icon">🥩</div><div class="pillar-text"><strong>Fresh Daily</strong><span>No frozen shortcuts</span></div></div>
          <div class="pillar"><div class="pillar-icon">🚀</div><div class="pillar-text"><strong>30-Min Delivery</strong><span>Hot, every time</span></div></div>
          <div class="pillar"><div class="pillar-icon">🌙</div><div class="pillar-text"><strong>24/7 Open</strong><span>Midnight cravings? We got you</span></div></div>
          <div class="pillar"><div class="pillar-icon">💰</div><div class="pillar-text"><strong>Fair Prices</strong><span>Premium taste, real value</span></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── TEAM ── -->
<section class="team-section">
  <div class="container">
    <div class="section-header centered reveal">
      <div class="section-label">THE TEAM</div>
      <h2 class="section-title">Meet the <span class="accent-text">Blazers</span></h2>
    </div>
    <div class="team-grid">
      <div class="team-card reveal">
        <div class="team-img"><img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&q=80" alt="Founder" loading="lazy"></div>
        <div class="team-body">
          <div class="team-name">Arjun Mehta</div>
          <div class="team-role">Founder & Head Chef</div>
          <div class="team-bio">Former Marriott chef who quit to chase his dream. The brain behind every recipe.</div>
          <div class="team-socials">
            <a href="#" class="team-social"><i class="fab fa-instagram"></i></a>
            <a href="#" class="team-social"><i class="fab fa-linkedin"></i></a>
          </div>
        </div>
      </div>
      <div class="team-card reveal">
        <div class="team-img"><img src="https://images.unsplash.com/photo-1580489944761-15a19d654956?w=400&q=80" alt="COO" loading="lazy"></div>
        <div class="team-body">
          <div class="team-name">Priya Sharma</div>
          <div class="team-role">COO & Co-Founder</div>
          <div class="team-bio">IIM grad who handles ops, tech, and makes sure food arrives hot.</div>
          <div class="team-socials">
            <a href="#" class="team-social"><i class="fab fa-instagram"></i></a>
            <a href="#" class="team-social"><i class="fab fa-linkedin"></i></a>
          </div>
        </div>
      </div>
      <div class="team-card reveal">
        <div class="team-img"><img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80" alt="CTO" loading="lazy"></div>
        <div class="team-body">
          <div class="team-name">Rahul Dev</div>
          <div class="team-role">CTO</div>
          <div class="team-bio">Ex-Swiggy engineer powering the platform with AI and real-time tech.</div>
          <div class="team-socials">
            <a href="#" class="team-social"><i class="fab fa-github"></i></a>
            <a href="#" class="team-social"><i class="fab fa-linkedin"></i></a>
          </div>
        </div>
      </div>
      <div class="team-card reveal">
        <div class="team-img"><img src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&q=80" alt="Head of Growth" loading="lazy"></div>
        <div class="team-body">
          <div class="team-name">Sneha Iyer</div>
          <div class="team-role">Head of Growth</div>
          <div class="team-bio">Digital marketing wizard behind Blaze's 500% growth in 2 years.</div>
          <div class="team-socials">
            <a href="#" class="team-social"><i class="fab fa-instagram"></i></a>
            <a href="#" class="team-social"><i class="fab fa-twitter"></i></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── TESTIMONIALS ── -->
<section class="testimonials">
  <div class="container">
    <div class="section-header centered reveal">
      <div class="section-label">WHAT THEY SAY</div>
      <h2 class="section-title">Customer <span class="accent-text">Love</span></h2>
    </div>
    <div class="testimonials-slider reveal">
      <div class="testimonials-track" id="testimonialsTrack">
        <div class="testimonial-slide">
          <div class="testimonial-card">
            <div class="testimonial-stars">★★★★★</div>
            <p class="testimonial-text">"The Korean BBQ Burger changed my life. I've ordered it 8 times this month and I have zero regrets. Blaze Kitchen is THE best cloud kitchen in Bangalore."</p>
            <div class="testimonial-author">
              <img class="testimonial-avatar" src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&q=80" alt="Customer">
              <div><div class="testimonial-name">Karthik Nair</div><div class="testimonial-loc">Koramangala, Bangalore</div></div>
            </div>
          </div>
        </div>
        <div class="testimonial-slide">
          <div class="testimonial-card">
            <div class="testimonial-stars">★★★★★</div>
            <p class="testimonial-text">"Order arrived in 22 minutes, piping hot. The Molten Lava Cake is the most dangerous thing I've ever eaten — I can't stop ordering it. My wallet hates Blaze."</p>
            <div class="testimonial-author">
              <img class="testimonial-avatar" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80" alt="Customer">
              <div><div class="testimonial-name">Ananya Krishnan</div><div class="testimonial-loc">Indiranagar, Bangalore</div></div>
            </div>
          </div>
        </div>
        <div class="testimonial-slide">
          <div class="testimonial-card">
            <div class="testimonial-stars">★★★★★</div>
            <p class="testimonial-text">"We ordered the Family Feast Box for our office team of 4 and it was PERFECT. Massive portions, incredible quality, great value. Blaze is our go-to now."</p>
            <div class="testimonial-author">
              <img class="testimonial-avatar" src="https://images.unsplash.com/photo-1527980965255-d3b416303d12?w=100&q=80" alt="Customer">
              <div><div class="testimonial-name">Vikram Patel</div><div class="testimonial-loc">Whitefield, Bangalore</div></div>
            </div>
          </div>
        </div>
      </div>
      <div class="testimonial-controls">
        <button class="testimonial-btn" aria-label="Previous"><i class="fas fa-chevron-left"></i></button>
        <button class="testimonial-btn" aria-label="Next"><i class="fas fa-chevron-right"></i></button>
      </div>
      <div class="testimonial-dots">
        <div class="t-dot active"></div><div class="t-dot"></div><div class="t-dot"></div>
      </div>
    </div>
  </div>
</section>

<!-- ── CONTACT ── -->
<section class="contact" id="contact">
  <div class="container">
    <div class="section-header centered reveal">
      <div class="section-label">REACH US</div>
      <h2 class="section-title">Get in <span class="accent-text">Touch</span></h2>
    </div>
    <div class="contact-grid reveal">
      <div class="contact-card">
        <div class="contact-icon-wrap"><i class="fas fa-location-dot"></i></div>
        <h4>Address</h4><p>123 Food Street,<br>Culinary City, Bangalore</p>
      </div>
      <div class="contact-card">
        <div class="contact-icon-wrap"><i class="fas fa-phone"></i></div>
        <h4>Phone</h4><p>+91 9876543210<br>Mon–Sun, 11AM–11PM</p>
      </div>
      <div class="contact-card">
        <div class="contact-icon-wrap"><i class="fas fa-envelope"></i></div>
