      <span class="coupon-chip" onclick="document.getElementById('couponCode').value='BLAZE50'">BLAZE50</span>
      <span class="coupon-chip" onclick="document.getElementById('couponCode').value='FIRST100'">FIRST100</span>
      <span class="coupon-chip" onclick="document.getElementById('couponCode').value='MIDNIGHT'">MIDNIGHT</span>
      <span class="coupon-chip" onclick="document.getElementById('couponCode').value='VIP200'">VIP200</span>
    </p>
